# ==============================================================================
# CNA Mobile Store - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit secret keys.

# ------------------------------------------------------------------------------
# 1. Data Source Mode
# ------------------------------------------------------------------------------
# Options: 'mock' (default for local preview) | 'supabase' (live cloud database)
VITE_DATA_SOURCE=mock

# ------------------------------------------------------------------------------
# 2. Supabase Infrastructure Configuration (Public Client Credentials)
# ------------------------------------------------------------------------------
# Project URL (e.g., https://your-project-id.supabase.co)
# Must start with https:// in production. http:// is allowed only for localhost in dev.
VITE_SUPABASE_URL=

# Supabase Public Keys:
# VITE_SUPABASE_PUBLISHABLE_KEY has primary precedence (modern sb_publishable_... keys).
VITE_SUPABASE_PUBLISHABLE_KEY=

# VITE_SUPABASE_ANON_KEY provides backward compatibility for legacy projects (eyJ... keys).
# If both keys are defined, VITE_SUPABASE_PUBLISHABLE_KEY will be selected automatically.
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. AI Capabilities (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# SECURITY NOTICE:
# - NEVER expose service_role or SUPABASE_SECRET_KEY in frontend code or client bundles.
# - Do NOT prefix secret keys with VITE_.
